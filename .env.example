DATABASE_URL=postgres://ncmail:ncmail@localhost:5432/ncmail
API_PORT=4000
# 32 random bytes, base64. Encrypts stored mail passwords. Generate: openssl rand -base64 32
SECRET_KEY=
# Your Nextcloud instance. The UI loads its live theme (branding, colours, dark mode) from here.
# Leave empty to use built-in Nextcloud-style defaults.
NEXTCLOUD_URL=

# Set to "nextcloud": Mail only works inside Nextcloud (the Nextcloud app vouches for users); accounts belong to the Nextcloud user who added them (needs NEXTCLOUD_URL)
NCMAIL_AUTH=

# With sign-in on, mail/calendar servers on private addresses are refused. allow = permit them (dev), or a comma-separated allow-list of hosts
NCMAIL_PRIVATE_HOSTS=
# 1 when behind a reverse proxy (trust X-Forwarded-*); NCMAIL_REQUIRE_TLS=1 refuses unencrypted connections
NCMAIL_TRUST_PROXY=
NCMAIL_REQUIRE_TLS=
# Previous key(s) while rotating SECRET_KEY (then run pnpm --filter @ncmail/api rotate-key)
SECRET_KEY_OLD=

# Mail servers an administrator sets up for everyone (see deploy/mail-servers.example.json)
NCMAIL_MAIL_CONFIG=
# Minutes a session lasts without a fresh token from Nextcloud (it is renewed while the Nextcloud session lives)
NCMAIL_SESSION_MINUTES=15
# Pin Nextcloud's signing key instead of fetching it (shown in Nextcloud's admin settings)
NCMAIL_HANDOFF_PUBLIC_KEY=
