{
  "name": "@ncmail/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --watch --import tsx src/server.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node --env-file=../../.env --import tsx src/server.ts",
    "adopt-accounts": "node --env-file=../../.env scripts/adopt-accounts.mjs",
    "rotate-key": "node --env-file=../../.env --import tsx scripts/rotate-key.ts",
    "test:upgrade": "tsx test/upgrade/run.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/etag": "^6.2.2",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.12",
    "@ncmail/shared": "workspace:*",
    "fast-xml-parser": "^5.12.1",
    "fastify": "^5.2.0",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.12.1",
    "mailparser": "^3.15.0",
    "node-forge": "^1.4.4",
    "nodemailer": "^10.6.1",
    "openpgp": "^6.3.3",
    "pg": "^8.13.0",
    "sanitize-html": "^2.18.2",
    "tsx": "^4.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "@types/sanitize-html": "^2.16.2",
    "typescript": "^5.7.0",
    "vitest": "^5.1.1"
  },
  "license": "Apache-2.0"
