# Where your Nextcloud is (users' browsers and this server both reach it here)
NEXTCLOUD_URL=https://cloud.example.com
# Recommended: where users' browsers reach Mail, the same as the Nextcloud app's "url" setting (for example https://mail.example.com).
# Sign-in tokens issued for another address are then refused.
NCMAIL_PUBLIC_URL=
# Encrypts stored mail passwords. Generate once and keep it safe: openssl rand -base64 32
SECRET_KEY=
POSTGRES_PASSWORD=
# The NCMail release to run (defaults to the one this compose file came with); raise it to update
# NCMAIL_VERSION=
